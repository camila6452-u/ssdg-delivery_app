{
	"name": "df_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          fecha_pago as string,",
				"          metodo_pago as string,",
				"          estado_pago as string,",
				"          monto_pagado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_pago = toDate(fecha_pago),",
				"          metodo_pago = ERROR_FUNCTION(''),",
				"          estado_pago = ERROR_FUNCTION(''),",
				"          monto_pagado = toDecimal(replace(replace(trim(monto_pagado),\",\",\".\"),\"Bs \",\"\"))) ~> derivedColumn1"
			]
		}
	}
}